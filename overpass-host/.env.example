# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The images: ghcr.io/ingel81/3dtd-osm-{overpass,proxy,clone}. latest is built from main, next from next
# (with every change of overpass-host there); sha-<8 hex> pins one commit
OVERPASS_HOST_TAG=next
OVERPASS_HOST_IMAGES=ghcr.io/ingel81

# Where the database lives (about 280 GB after the clone, on a fast disk), and the statistics
OVERPASS_DATA=/path/to/overpass-data
STATS_DIR=./stats

# The tunnel: by default the cloudflared container that runs already (the coop lobby's), on its network
# TUNNEL_NETWORK; that tunnel gets the public hostname 3dtd-osm.sgeht.net -> http://3dtd-osm-proxy:8080.
# (On Windows, COMPOSE_FILE parts are parted by ";" instead of ":".)
COMPOSE_FILE=docker-compose.yml:docker-compose.shared-tunnel.yml
TUNNEL_NETWORK=tunnel
# Or a tunnel of its own: COMPOSE_FILE=docker-compose.yml, COMPOSE_PROFILES=tunnel and the connector's token
# (Cloudflare Zero Trust, Networks, Tunnels). Without either, as for a local test: COMPOSE_FILE=docker-compose.yml
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# The status page, for the LAN only: bind it to the server's LAN address rather than 0.0.0.0
STATUS_BIND=0.0.0.0
STATUS_PORT=8090

# Overpass: queries at once, and the memory of its container
OVERPASS_SLOTS=8
OVERPASS_MEMORY=16g
# Memory (bytes) and time (s) all running queries may reserve together (dispatcher --space, --time)
OVERPASS_SPACE=10737418240
OVERPASS_TIME=3600

# Pages that may use the server (CORS); a request without an Origin (no browser) passes unless ALLOW_NO_ORIGIN=0
ALLOWED_ORIGINS=https://3dtd.sgeht.net,app://app,http://localhost:4200
ALLOW_NO_ORIGIN=1
# The client's address and country from Cloudflare's headers (CF-Connecting-IP, CF-IPCountry)
TRUST_CLOUDFLARE=1

# What one query may read: the longest edge of any of its boxes, the area of all of them together
MAX_EDGE_KM=5
MAX_AREA_KM2=30
# Caps of [timeout:] (s) and [maxsize:] (MB); a query asking more, or nothing, gets the cap
MAX_TIMEOUT_S=90
MAX_MAXSIZE_MB=256

# One client (an address, IPv6 per /64): queries after a quiet while, per minute after that, at once
RATE_BURST=20
RATE_PER_MINUTE=30
RATE_CONCURRENT=4
# Queries waiting for a slot of Overpass at most, and how long (s); past that 503, ask another server
QUEUE_MAX=32
QUEUE_WAIT_S=20

# Days the statistics keep
STATS_DAYS=30

# The clone's download: files at once, connections per file
CLONE_JOBS=2
CLONE_SPLIT=4
