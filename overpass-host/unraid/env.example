# The .env of the Unraid stack (README.md, "On Unraid"): next to docker-compose.yml and docker-compose.clone.yml
# of this folder, or in the Compose Manager's editor (tab ENV). No COMPOSE_FILE here: the plugin would load the
# files it names as well. Never commit it.

# The images: latest is built from main, next from next; sha-<8 hex> pins one commit
OVERPASS_HOST_TAG=next
OVERPASS_HOST_IMAGES=ghcr.io/ingel81

# Absolute paths on a pool (/mnt/cache/..., not /mnt/user/...): the database (about 280 GB) and the statistics
OVERPASS_DATA=/mnt/cache/appdata/3dtd-osm/data
STATS_DIR=/mnt/cache/appdata/3dtd-osm/stats

# The external Docker network (Unraid: br0 or a VLAN of it, as Settings, Docker lists it) and a free fixed address
# each: the tunnel reaches the proxy at http://<PROXY_IP>:8080, the LAN the status page at http://<STATUS_IP>:8090.
# STATUS_NETWORK puts the status page on another network (empty: the proxy's)
LAN_NETWORK=br0
STATUS_NETWORK=
PROXY_IP=
STATUS_IP=

# Overpass: queries at once, and the memory of its container
OVERPASS_SLOTS=8
OVERPASS_MEMORY=16g
OVERPASS_SPACE=10737418240
OVERPASS_TIME=3600

# Pages that may use the server (CORS); a request without an Origin (no browser) passes unless ALLOW_NO_ORIGIN=0
ALLOWED_ORIGINS=https://3dtd.sgeht.net,app://app,http://localhost:4200
ALLOW_NO_ORIGIN=1
# The client's address and country from Cloudflare's headers (CF-Connecting-IP, CF-IPCountry), taken only on a
# connection from TRUSTED_PROXIES (CIDR list; "private" = loopback, 10/8, 172.16/12, 192.168/16, IPv6 local); on any
# other the connection's own address counts. Set the address the tunnel's connector comes from (<address>/32), so a
# machine of the LAN that reaches the proxy directly cannot name an address of its choice; the proxy's log names it once
TRUST_CLOUDFLARE=1
TRUSTED_PROXIES=private

# What one query may read: the longest edge of any of its boxes, the area of all of them together
MAX_EDGE_KM=5
MAX_AREA_KM2=30
# Caps of [timeout:] (s) and [maxsize:] (MB); a query asking more, or nothing, gets the cap
MAX_TIMEOUT_S=90
MAX_MAXSIZE_MB=256

# One client (an address, IPv6 per /64): queries after a quiet while, per minute after that, at once
RATE_BURST=20
RATE_PER_MINUTE=30
RATE_CONCURRENT=4
# Queries waiting for a slot of Overpass at most, and how long (s); past that 503, ask another server
QUEUE_MAX=32
QUEUE_WAIT_S=20

# Days the statistics keep
STATS_DAYS=30

# The clone's download: files at once, connections per file
CLONE_JOBS=2
CLONE_SPLIT=4
